---
import PageLayout from '../layouts/PageLayout.astro';
import data from '../data/about.json';

const { currently, skillGroups, certs } = data;
---

<PageLayout page="about" title="About — Anandu">
  <p class="panel__label label">About</p>
  <h2 class="panel__heading">I build for the full&nbsp;stack —<br><em>API to infrastructure.</em></h2>

  <div class="stat-strip">
    <div class="stat">
      <span class="stat__label">years shipping</span>
      <span class="stat__num">4+</span>
    </div>
    <div class="stat">
      <span class="stat__label">gov agencies</span>
      <span class="stat__num">2</span>
    </div>
    <div class="stat">
      <span class="stat__label">tools underway</span>
      <span class="stat__num">4</span>
    </div>
    <div class="stat">
      <span class="stat__label">languages</span>
      <span class="stat__num">6</span>
    </div>
  </div>

  <div class="about__cols">

    <!-- ── Bio ─────────────────────────────────────────────── -->
    <div class="about__bio">

      <p class="bio__lead">
        Fullstack engineer with a strong pull toward DevOps. Currently a Consultant
        at Deloitte Canada — shipping production systems across government and
        enterprise clients.
      </p>

      <p>
        At <span class="serif">Deloitte</span>, I've worked across public sector
        engagements — including projects with <span class="serif">ESDC</span>
        (Employment and Social Development Canada) and the
        <span class="serif">Government of Quebec</span>. Fullstack development,
        cloud infrastructure, and DevOps practice on systems that need to be
        reliable at scale.
      </p>

      <p>
        Before that, independent contractor work as a Shopify developer — building
        editorial, high-design storefronts for brands like
        <span class="serif">Basma Beauty</span> and
        <span class="serif">Sol Botanicals</span> through
        <span class="serif">Off Paper Creative</span>.
        Custom Liquid templates, bespoke UI, pixel-perfect execution.
      </p>

      <blockquote class="bio__pull">
        Observable systems. Repeatable deploys.<br>
        Code <em>easy enough to delete.</em>
      </blockquote>

      <p>
        Outside client work, I build tools for myself — right now, a set of
        small, focused agent-tooling projects: plugins and CLIs meant to make
        agentic development safer and more trustworthy, one layer at a time,
        from a single risky action up through whether the code that shipped
        actually matched the plan. Details on the Projects page.
      </p>

      <p>
        Comfortable across the Kubernetes ecosystem — Helm, ArgoCD, container
        registries. Rust when performance is the constraint; Go when speed of
        iteration is.
      </p>

    </div>

    <!-- ── Sidebar ──────────────────────────────────────────── -->
    <aside class="about__sidebar">

      <div class="sidebar__block">
        <p class="label sidebar__label">Currently</p>
        <p class="sidebar__role">{currently.role}</p>
        <p class="label sidebar__detail">{currently.org}</p>
        <p class="label sidebar__detail sidebar__detail--muted">{currently.location}</p>
      </div>

      {skillGroups.map(group => (
        <div class="sidebar__block">
          <p class="label sidebar__label">{group.label}</p>
          <ul class="skills-list" role="list">
            {group.items.map(s => <li class="label skills-list__item">{s}</li>)}
          </ul>
        </div>
      ))}

      <div class="sidebar__block">
        <p class="label sidebar__label">Certifications</p>
        {certs.map(c => (
          <div class="cert">
            <div class="cert__top">
              <span class="label cert__badge">{c.name}</span>
              <span class="label cert__year">{c.year}</span>
            </div>
            <span class="cert__name">{c.full}</span>
          </div>
        ))}
      </div>

    </aside>

  </div>
</PageLayout>

<style>
  .panel__label {
    color: var(--clr-muted);
    margin-bottom: 1.25rem;
    display: block;
  }

  .panel__heading {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--clr-ink);
    margin-bottom: 2.5rem;
  }

  .panel__heading em { font-style: italic; font-weight: 400; }

  /* ── Stat strip ──────────────────────────────────────────── */
  .stat-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0 2rem;
    border-top: 1px solid var(--clr-rule);
    border-bottom: 1px solid var(--clr-rule);
    padding: 1.5rem 0;
    margin-bottom: 3rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .stat__label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clr-muted);
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--clr-rule);
    margin-bottom: 0.65rem;
  }

  .stat__num {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.85;
    color: var(--clr-ink);
  }

  @media (max-width: 640px) {
    .stat-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 2rem;
    }
  }

  /* ── Layout ───────────────────────────────────────────────── */
  .about__cols {
    display: grid;
    grid-template-columns: 1fr clamp(180px, 30%, 240px);
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 640px) {
    .about__cols {
      grid-template-columns: 1fr;
    }

    .about__sidebar {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--clr-rule);
      padding-top: 2rem;
      margin-top: 0.5rem;
    }
  }

  /* ── Bio ──────────────────────────────────────────────────── */
  .about__bio {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--clr-ink-2);
    font-size: 1rem;
    line-height: 1.85;
  }

  .bio__lead {
    font-size: 1.05rem;
    color: var(--clr-ink);
    line-height: 1.75;
  }

  .serif {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 1.05em;
    color: var(--clr-ink);
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 0.88em;
    color: var(--clr-ink);
  }

  .bio__pull {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--clr-ink);
    margin-block: 0.25rem;
    padding-left: 1.25rem;
    border-left: 1.5px solid var(--clr-ink);
  }

  .bio__pull em {
    font-weight: 400;
    font-style: italic;
  }

  /* ── Sidebar ──────────────────────────────────────────────── */
  .about__sidebar {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--clr-rule);
    padding-left: 1.75rem;
  }

  .sidebar__block {
    padding-block: 1.25rem;
    border-top: 1px solid var(--clr-rule);
  }

  .sidebar__block:first-child {
    padding-top: 0;
    border-top: none;
  }

  .sidebar__label {
    color: var(--clr-muted);
    display: block;
    margin-bottom: 0.6rem;
  }

  .sidebar__role {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--clr-ink);
    line-height: 1.3;
    margin-bottom: 0.35rem;
  }

  .sidebar__detail {
    color: var(--clr-ink);
    display: block;
    line-height: 1.8;
  }

  .sidebar__detail--muted { color: var(--clr-muted); }

  /* ── Skills ───────────────────────────────────────────────── */
  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .skills-list__item {
    color: var(--clr-ink-2);
    padding-block: 0.4rem;
    border-top: 1px solid var(--clr-rule);
    line-height: 1.5;
  }

  .skills-list__item:first-child {
    border-top: none;
    padding-top: 0;
  }

  /* ── Certs ────────────────────────────────────────────────── */
  .cert {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--clr-rule);
  }

  .cert:first-of-type { border-top: none; padding-top: 0; }

  .cert__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .cert__badge { color: var(--clr-ink); }
  .cert__year  { color: var(--clr-muted); }
  .cert__name  { font-size: 0.82rem; color: var(--clr-ink-2); line-height: 1.4; }
</style>
