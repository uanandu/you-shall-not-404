---
import PageLayout from '../layouts/PageLayout.astro';
import Playground from '../components/svelte/Playground.svelte';
import { t } from '../i18n/ui';
---

<PageLayout page="playground" title={t('en', 'playground.title')}>
  <p class="panel__label label">{t('en', 'playground.label')}</p>
  <h2 class="panel__heading">{t('en', 'playground.heading')} <em>{t('en', 'playground.heading.em')}</em></h2>
  <Playground lang="en" client:visible />
</PageLayout>

<style>
  .panel__label {
    color: var(--clr-muted);
    margin-bottom: 1.25rem;
    display: block;
  }

  .panel__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--clr-ink);
    margin-bottom: 2rem;
  }

  .panel__heading em { font-style: italic; font-weight: 400; }
</style>
