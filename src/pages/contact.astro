---
import PageLayout from '../layouts/PageLayout.astro';
import ContactCard from '../components/svelte/ContactCard.svelte';
---

<PageLayout page="contact" title="Contact — Anandu">
  <p class="panel__label label">Contact</p>
  <h2 class="panel__heading">Let's build<br><em>something worth shipping.</em></h2>

  <div class="contact__cols">
    <div class="contact__aside">
      <p class="contact__intro">
        Open to interesting problems — new products, infrastructure work,
        consulting, or just a conversation about systems that actually scale.
      </p>
      <p class="contact__intro contact__intro--em">
        The best outcomes I've had started with a direct message.
      </p>
      <a href="mailto:anandu_dev@icloud.com" class="contact__email label">
        anandu_dev@icloud.com →
      </a>
      <div class="contact__social">
        <p class="label contact__social-label">Elsewhere</p>
        <a href="https://github.com/uanandu" target="_blank" rel="noopener" class="contact__link label">
          GitHub ↗
        </a>
        <a href="https://www.linkedin.com/in/uanandu/" target="_blank" rel="noopener" class="contact__link label">
          LinkedIn ↗
        </a>
      </div>
    </div>

    <ContactCard client:visible />
  </div>
</PageLayout>

<style>
  .panel__label {
    color: var(--clr-muted);
    margin-bottom: 1.25rem;
    display: block;
  }

  .panel__heading {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--clr-ink);
    margin-bottom: 2.5rem;
  }

  .panel__heading em { font-style: italic; font-weight: 400; }

  .contact__cols {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 640px) {
    .contact__cols { grid-template-columns: 1fr; gap: 2rem; }
  }

  .contact__aside { display: flex; flex-direction: column; gap: 1rem; }

  .contact__intro {
    color: var(--clr-ink-2);
    font-size: 1rem;
    line-height: 1.85;
  }

  .contact__intro--em {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--clr-ink);
    line-height: 1.5;
  }

  .contact__email {
    display: inline-block;
    color: var(--clr-ink);
    border-bottom: 1px solid var(--clr-rule);
    padding-bottom: 0.15rem;
    transition: border-color var(--transition);
    margin-top: 0.25rem;
  }

  .contact__email:hover { border-color: var(--clr-ink); }

  .contact__social {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--clr-rule);
    margin-top: 0.25rem;
  }

  .contact__social-label { color: var(--clr-muted); }

  .contact__link {
    display: inline-block;
    color: var(--clr-ink);
    border-bottom: 1px solid var(--clr-rule);
    padding-bottom: 0.15rem;
    transition: border-color var(--transition);
  }

  .contact__link:hover { border-color: var(--clr-ink); }
</style>
