---
import PageLayout from '../layouts/PageLayout.astro';
import ProjectList from '../components/svelte/ProjectList.svelte';
---

<PageLayout page="projects" title="Projects — Anandu">
  <p class="panel__label label">Personal projects</p>
  <h2 class="panel__heading">Side projects &<br><em>how they connect.</em></h2>

  <p class="panel__intro">
    Trust infrastructure for agentic development, one layer at a time — from not trusting a
    single risky action, up through whether shipped code actually matched the plan.
  </p>

  <blockquote class="panel__pull">
    Don't trust one action, one session, or unbounded concurrency.<br>
    Don't trust a plan nobody checked against.<br>
    <em>The same discipline production systems demand — pointed at agents instead of servers.</em>
  </blockquote>

  <ProjectList client:visible />
</PageLayout>

<style>
  .panel__label {
    color: var(--clr-muted);
    margin-bottom: 1.25rem;
    display: block;
  }

  .panel__heading {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--clr-ink);
    margin-bottom: 1rem;
  }

  .panel__heading em { font-style: italic; font-weight: 400; }

  .panel__intro {
    font-size: 1rem;
    color: var(--clr-ink-2);
    line-height: 1.75;
    margin-bottom: 2rem;
    max-width: 52ch;
  }

  .panel__pull {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--clr-ink);
    margin: 0 0 2.5rem;
    padding-left: 1.25rem;
    border-left: 1.5px solid var(--clr-ink);
    max-width: 52ch;
  }

  .panel__pull em { font-weight: 400; font-style: italic; }
</style>
