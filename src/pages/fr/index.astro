---
import PageLayout from '../../layouts/PageLayout.astro';
import Typewriter from '../../components/svelte/Typewriter.svelte';
import { t } from '../../i18n/ui';
---
<PageLayout page="home" title={t('fr', 'home.title')} lang="fr">

  <!-- Left column: below the name -->
  <div slot="rail-desc" class="home__desc">
    <p class="home__desc-role label">{t('fr', 'home.role')}</p>
    <Typewriter
      line1={t('fr', 'home.tagline1')}
      line2={t('fr', 'home.tagline2')}
      client:load
    />
  </div>

  <!-- Right column: portrait -->
  <div slot="rail-extra" class="home__right">
    <picture transition:name="portrait">
      <source srcset="/anandu.webp" type="image/webp" />
      <img
        src="/anandu.png"
        class="portrait"
        alt="Anandu"
        width="798"
        height="1024"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>

</PageLayout>

<style>
  /* ── Desktop ──────────────────────────────────────────────── */
  .home__desc {
    border-top: 1px solid var(--clr-rule);
    padding-top: 1rem;
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
  }

  .home__desc-role {
    color: var(--clr-muted);
    display: block;
  }

  .home__right {
    align-self: stretch;
    width: clamp(260px, 36vw, 500px);
    padding-top: 5rem;
  }

  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* ── Mobile ───────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .home__right {
      flex: 1;
      min-height: 0;
      width: 100%;
      padding-top: 0;
    }

    .portrait {
      object-position: center 12%;
    }

    .home__desc {
      flex-shrink: 0;
      margin-top: 0.65rem;
      padding-top: 0;
      border-top: none;
      text-align: center;
      align-items: center;
    }
  }
</style>
