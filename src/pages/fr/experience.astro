---
import PageLayout from '../../layouts/PageLayout.astro';
import { t } from '../../i18n/ui';
import data from '../../data/experience.fr.json';

const { companies, education } = data;
---

<PageLayout page="experience" title="Expérience — Anandu" lang="fr">
  <p class="panel__label label">{t('fr', 'experience.label')}</p>
  <h2 class="panel__heading">{t('fr', 'experience.heading')}<br><em>{t('fr', 'experience.heading.em')}</em></h2>

  <ol class="co-list">
    {companies.map(co => (
      <li class="co">
        <div class="co__header">
          <div class="co__header-left">
            <h3 class="co__name">{co.name}</h3>
            <span class="label co__period">{co.period}</span>
          </div>
          <ul class="co__stack" aria-label="Stack">
            {co.stack.map(t => <li class="label co__tag">{t}</li>)}
          </ul>
        </div>

        <ol class="role-list">
          {co.roles.map(role => (
            <li class="role">
              <div class="role__aside">
                <span class="label role__period">{role.period}</span>
              </div>
              <div class="role__body">
                <p class="role__title">{role.title}</p>
                <p class="role__desc">{role.desc}</p>
                {role.projects.length > 0 && (
                  <ul class="proj-list">
                    {role.projects.map(p => (
                      <li class="proj">
                        <span class="label proj__name">{p.name}</span>
                        <span class="proj__detail">{p.detail}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </li>
    ))}
  </ol>

  <p class="panel__label label education-label">{t('fr', 'experience.education')}</p>

  <ol class="co-list">
    {education.map(edu => (
      <li class="co">
        <div class="co__header">
          <div class="co__header-left">
            <h3 class="co__name">{edu.institution}</h3>
            <span class="label co__period">{edu.period}</span>
          </div>
        </div>
        <ol class="role-list">
          <li class="role">
            <div class="role__aside">
              <span class="label role__period">{edu.year}</span>
            </div>
            <div class="role__body">
              <p class="role__title">{edu.degree}</p>
            </div>
          </li>
        </ol>
      </li>
    ))}
  </ol>
</PageLayout>

<style>
  .panel__label {
    color: var(--clr-muted);
    margin-bottom: 1.25rem;
    display: block;
  }

  .panel__heading {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--clr-ink);
    margin-bottom: 2.5rem;
  }

  .panel__heading em { font-style: italic; font-weight: 400; }

  .education-label {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--clr-rule);
  }

  /* ── Company blocks ───────────────────────────────────────── */
  .co-list { display: flex; flex-direction: column; }

  .co {
    border-top: 1px solid var(--clr-rule);
    padding-block: 2rem;
  }

  .co:last-child { border-bottom: 1px solid var(--clr-rule); }

  .co__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .co__header-left {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .co__name {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    font-weight: 700;
    color: var(--clr-ink);
    line-height: 1;
  }

  .co__period { color: var(--clr-muted); }

  .co__stack {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .co__tag {
    color: var(--clr-muted);
    border: 1px solid var(--clr-rule);
    padding: 0.1rem 0.45rem;
  }

  /* ── Roles within a company ───────────────────────────────── */
  .role-list { display: flex; flex-direction: column; gap: 0; }

  .role {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.25rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--clr-rule);
  }

  .role__aside { padding-top: 0.15rem; }

  .role__period { color: var(--clr-muted); display: block; }

  .role__body { display: flex; flex-direction: column; gap: 0.3rem; }

  .role__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 1.05rem;
    color: var(--clr-ink);
    line-height: 1.3;
  }

  .role__desc {
    font-size: 1rem;
    color: var(--clr-ink-2);
    line-height: 1.75;
  }

  /* ── Project entries under a role ────────────────────────── */
  .proj-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 0.6rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--clr-rule);
  }

  .proj {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-block: 0.55rem;
    border-top: 1px solid var(--clr-rule);
  }

  .proj:first-child { border-top: none; }

  .proj__name { color: var(--clr-ink); }

  .proj__detail {
    font-size: 0.875rem;
    color: var(--clr-muted);
    line-height: 1.65;
  }

  @media (max-width: 480px) {
    .co__header { flex-direction: column; gap: 0.5rem; }
    .co__stack { justify-content: flex-start; }
    .role { grid-template-columns: 1fr; gap: 0.4rem; }
  }
</style>
